# Wisenomy — variables de entorno (plantilla pública, sin secretos reales)
#
# Cómo usar este archivo:
#   - En LOCAL: copia este archivo a .env y rellena los valores que necesites.
#     El archivo .env real NO se sube a git (está en .gitignore).
#   - En PRODUCCIÓN (Railway): configura estas variables desde el panel "Variables"
#     del servicio. No necesitas crear un .env en el servidor.

# --- Entorno ---
# 'production' silencia errores en pantalla y los registra. 'development' los muestra.
APP_ENV=development

# URL pública canónica de la aplicación. Se usa para construir enlaces en los emails
# (verificación, recuperación, invitaciones). En local puedes dejarla vacía y se
# infiere del request actual.
APP_URL=

# Indica que la app está detrás de un proxy de confianza (Cloudflare → Railway).
# Activa el respeto a X-Forwarded-Proto (HTTPS) y X-Forwarded-For (IP real).
# En local debe estar a 0.
TRUST_PROXY=0

# --- Base de datos ---
# Si DATABASE_URL no está definida, la app usa SQLite en data/app.sqlite (dev local).
# Formato Postgres: postgres://usuario:password@host:puerto/nombre_db?sslmode=require
# Railway inyecta esta variable automáticamente al añadir un servicio PostgreSQL.
# DATABASE_URL=postgres://user:pass@host:5432/wisenomy?sslmode=require

# --- Correo (Resend) ---
# API key de Resend (https://resend.com). Si no se define, los emails se escriben
# en data/mail.log para que puedas inspeccionarlos en desarrollo.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección remitente de los correos. Debe ser de un dominio verificado en Resend.
MAIL_FROM=noreply@wisenomy.app

# --- Verificación de email ---
# Si está activada, los usuarios deben verificar su email antes de iniciar sesión.
# Ponlo a 0 solo si tienes una razón clara (p. ej. importar usuarios masivamente).
REQUIRE_EMAIL_VERIFICATION=1
